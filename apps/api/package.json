{
    "name": "@r-gram/api",
    "private": true,
    "version": "0.1.1",
    "type": "module",
    "scripts": {
        "build:admin": "npm run build -w @r-gram/admin",
        "dev": "npm run build:admin && wrangler dev --local-protocol https",
        "migrate:local": "wrangler d1 migrations apply r-gram --local",
        "check:deploy": "node scripts/check-deploy-config.mjs",
        "premigrate:remote": "npm run check:deploy",
        "migrate:remote": "wrangler d1 migrations apply r-gram --remote",
        "predeploy": "npm run check:deploy",
        "deploy": "npm run build:admin && wrangler deploy",
        "test": "vitest run",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@r-gram/catalog": "*",
        "hono": "^4.13.17"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.6.0",
        "@cloudflare/workers-types": "^5.20261108.1",
        "@types/node": "^22.19.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5",
        "wrangler": "^4.158.0"
    }
}
