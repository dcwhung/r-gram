{
    "name": "r-gram",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc -b",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    }
}
